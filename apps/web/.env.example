# ==============================================================================
# VitalBook Web (Next.js 14) Environment Configuration
# ==============================================================================
# Copy this template to .env.local for local development:
#   cp .env.example .env.local
#
# Production: Injected at build time via Netlify / Vercel Environment Variables
# ==============================================================================

# API Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_DEFAULT_CLINIC_ID=

# Passkey Gates (Optional)
NEXT_PUBLIC_ADMIN_PASSKEY=
NEXT_PUBLIC_DOCTOR_PASSKEY=

# Auth Secret
NEXTAUTH_SECRET=

# Firebase Phone Auth & reCAPTCHA Configuration
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_TEST_PHONE=
